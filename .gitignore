# Environment Secrets (Crucial to prevent API key leakage!)
.env
.env.local
.env.development.local
.env.test.local
.env.production.local

# Dependency directories
node_modules/
jspm_packages/
web_modules/

# Local databases and user credential JSONs (Secures local login data)
backend/users.json
# Runtime telemetry data (regenerated on each deployment)
backend/search_feedback.json

# Agent & AI tracking caches
.agents/
skills-lock.json
.antigravityignore

# Logs
logs
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# System Files
.DS_Store
Thumbs.db

# Python cache
__pycache__/
*.pyc
*.pyo
