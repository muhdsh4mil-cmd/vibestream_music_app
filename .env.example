# Server Configuration
PORT=3000

# YouTube Data API v3 Key
# Get your API key from Google Cloud Console: https://console.cloud.google.com/
YOUTUBE_API_KEY=

# Admin Portal Credentials (set strong values in production!)
ADMIN_USERNAME=
ADMIN_PASSWORD=

# CORS — set this to your deployed URL in production (e.g. https://vibestream.onrender.com)
# Leave blank or set to http://localhost:3000 for local development
ALLOWED_ORIGIN=
